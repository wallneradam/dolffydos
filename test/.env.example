# Dolffy DOS test configuration. Copy to test/.env (gitignored) and adjust paths.
# Only the proprietary drive ROMs need setting; everything else has sane defaults.
# Values already exported in your shell win over these.

# JiffyDOS 1541 drive ROM (you must own it). Enables the jiffy-serial tests.
JIFFY_DRIVE_ROM=/path/to/JiffyDOS_C1541.bin

# DolphinDOS 1541 drive ROM (32K, banked). Enables the dolphin-parallel tests.
DOLPHIN_DRIVE_ROM=/path/to/dd_1541.rom

# Optional overrides:
# X64SC=/opt/homebrew/bin/x64sc
# C1541=/opt/homebrew/bin/c1541
# DOLFFY_ROM=kernal/rom/dolffy.rom
# VICE_C64_DIR=/opt/homebrew/share/vice/C64
